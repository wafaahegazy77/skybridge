# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
/.next/
/out/
/build

# environment files (keep only the documented example)
.env
.env.*
!.env.example

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled SCSS output from editor extensions (Next.js compiles SCSS itself)
src/app/styles/scss/*.css
src/app/styles/scss/*.css.map

# deployment / OS / editor
.vercel
*.pem
.DS_Store
Thumbs.db
